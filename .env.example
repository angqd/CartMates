# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# The one household group; messages from other chats are ignored
TELEGRAM_GROUP_ID=
OPENAI_API_KEY=
# OpenAI model used by the agent loop
AGENT_MODEL=
# Optional: low / medium / high etc. for reasoning models; leave empty to not send it
AGENT_REASONING_EFFORT=
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
# Full id from get_addresses, e.g. d9lg...__AMVY...
SWIGGY_ADDRESS_ID=
# Approximate; the live check decides
FREE_DELIVERY_MIN=199
# UPI app Swiggy is told to pay in; the group gets a Pay button that opens Swiggy's https link
UPI_APP=gpay://upi/
# Seconds to wait for Swiggy's checkout call; on timeout the order is verified, never retried
CHECKOUT_TIMEOUT_S=45
# Max allowed total increase between bill card and live quote (0.05 = 5%)
PRICE_TOLERANCE=0.05
# SQLite file and tokens live here. Defaults to ./data when run locally.
# Leave this commented out for Docker: the image sets DATA_DIR=/data, and a value
# here (even an empty one) would override it and put the DB outside the volume.
# DATA_DIR=./data
LOG_LEVEL=INFO

# Tracing (optional). With no endpoint nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
# CARTMATES_TRACE_CONTENT=1
# CARTMATES_TRACE_MAX_CHARS=8000
